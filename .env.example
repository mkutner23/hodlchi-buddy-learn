# Copy this file to `.env` and fill in the values from your Lovable Cloud
# (Supabase) project. Never commit the filled `.env`.
#
# On Lovable, these are provisioned automatically when you enable Cloud —
# you only need this file for local development outside Lovable.

# Public keys (safe to expose to the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-side mirrors (used by server functions / SSR)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key
SUPABASE_PROJECT_ID=your-project-ref
